<templates xml:space="preserve">

    <t t-name="l10n_es_deca.DecaQrConfigure">
        <div class="o_deca_qr_configure">
            <div
        class="o_deca_qr_toolbar d-flex align-items-center gap-3 p-2 border-bottom"
      >
                <span class="fw-bold" t-esc="state.name" />
                <t t-if="state.editable">
                    <span class="text-muted small">
                        Drag the QR box where you want it, or pull its bottom-right
                        corner to resize it.
                    </span>
                    <div class="d-flex align-items-center gap-1 ms-auto">
                        <label class="mb-0" for="deca_qr_page">Page</label>
                        <input
              id="deca_qr_page"
              type="number"
              class="form-control form-control-sm"
              style="width: 5rem;"
              min="1"
              t-att-max="state.pageCount"
              t-att-value="state.page"
              t-on-change="onPageChange"
            />
                        <span class="text-muted small">/ <t
                t-esc="state.pageCount"
              /></span>
                    </div>
                    <div class="d-flex align-items-center gap-1">
                        <label class="mb-0" for="deca_qr_size">Size %</label>
                        <input
              id="deca_qr_size"
              type="number"
              class="form-control form-control-sm"
              style="width: 5.5rem;"
              min="1"
              max="50"
              step="0.5"
              t-att-value="state.size.toFixed(1)"
              t-on-change="onSizeChange"
            />
                    </div>
                    <button
            class="btn btn-primary btn-sm"
            t-att-disabled="!state.dirty"
            t-on-click="onSave"
          >Save</button>
                </t>
                <t t-else="">
                    <span class="text-muted small ms-auto">
                        The DeCA is no longer a draft, so the QR position cannot be
                        changed.
                    </span>
                </t>
            </div>
            <iframe class="o_deca_qr_iframe" t-att-src="viewerUrl" t-ref="iframe" />
        </div>
    </t>

</templates>
