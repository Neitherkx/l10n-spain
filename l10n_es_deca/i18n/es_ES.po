#. module: l10n_es_deca
#: model:mail.template,body_html:l10n_es_deca.mail_template_deca_issued
msgid ""
"<div style=\"margin:0px;padding:0px;font-size:13px;\">\n"
"                <p>Dear Sir or Madam,</p>\n"
"                <p>\n"
"                    The Electronic Administrative Control Document\n"
"                    <strong t-out=\"object.name\">DECA/2026/00001</strong>\n"
"                    has been issued for the transport scheduled on\n"
"                    <strong t-out=\"format_date(object.transport_date)\">09/21/2026</strong>.\n"
"                </p>\n"
"                <ul>\n"
"                    <li>Contractual shipper: <t t-out=\"object.shipper_id.name\"/> (<t t-out=\"object.shipper_vat\"/>)</li>\n"
"                    <li>Effective carrier: <t t-out=\"object.carrier_id.name\"/> (<t t-out=\"object.carrier_vat\"/>)</li>\n"
"                    <li>Tractor plate: <t t-out=\"object.tractor_plate_id.name or '-'\"/></li>\n"
"                    <li>Trailer plate: <t t-out=\"object.trailer_plate_id.name or '-'\"/></li>\n"
"                </ul>\n"
"                <p>\n"
"                    The document can be downloaded without identification from the\n"
"                    following link, the same one encoded in the QR printed on the PDF:\n"
"                    <br/>\n"
"                    <a t-att-href=\"object.public_url\" t-out=\"object.public_url\">link</a>\n"
"                </p>\n"
"                <p>\n"
"                    SHA-256 fingerprint of the PDF: <span t-out=\"object.pdf_sha256\"/>\n"
"                </p>\n"
"                <p>\n"
"                    Public access will be closed automatically on\n"
"                    <t t-out=\"format_date(object.access_close_date)\"/>,\n"
"                    seven calendar days after the end of the service.\n"
"                </p>\n"
"                <p><t t-out=\"object.company_id.name\"/></p>\n"
"            </div>\n"
"        "
msgstr ""
"<div style=\"margin:0px;padding:0px;font-size:13px;\">\n"
"                <p>Estimado/a,</p>\n"
"                <p>\n"
"                    Se ha emitido el Documento Electrónico de Control Administrativo\n"
"                    <strong t-out=\"object.name\">DECA/2026/00001</strong>\n"
"                    para el transporte previsto el\n"
"                    <strong t-out=\"format_date(object.transport_date)\">21/09/2026</strong>.\n"
"                </p>\n"
"                <ul>\n"
"                    <li>Cargador contractual: <t t-out=\"object.shipper_id.name\"/> (<t t-out=\"object.shipper_vat\"/>)</li>\n"
"                    <li>Transportista efectivo: <t t-out=\"object.carrier_id.name\"/> (<t t-out=\"object.carrier_vat\"/>)</li>\n"
"                    <li>Matrícula tractora: <t t-out=\"object.tractor_plate_id.name or '-'\"/></li>\n"
"                    <li>Matrícula remolque: <t t-out=\"object.trailer_plate_id.name or '-'\"/></li>\n"
"                </ul>\n"
"                <p>\n"
"                    El documento puede descargarse sin identificación desde el\n"
"                    siguiente enlace, el mismo que codifica el QR impreso en el PDF:\n"
"                    <br/>\n"
"                    <a t-att-href=\"object.public_url\" t-out=\"object.public_url\">enlace</a>\n"
"                </p>\n"
"                <p>\n"
"                    Huella SHA-256 del PDF: <span t-out=\"object.pdf_sha256\"/>\n"
"                </p>\n"
"                <p>\n"
"                    El acceso público se cerrará automáticamente el\n"
"                    <t t-out=\"format_date(object.access_close_date)\"/>,\n"
"                    siete días naturales después del fin del servicio.\n"
"                </p>\n"
"                <p><t t-out=\"object.company_id.name\"/></p>\n"
"            </div>\n"
"        "

#. module: l10n_es_deca
#: model_terms:web_tour.tour,rainbow_man_message:l10n_es_deca.tour_deca_onboarding
msgid ""
"<span><b>That is the whole DeCA flow.</b> And if you would rather carry your"
" own delivery note, a draft DeCA turns it into the document with <b>Convert "
"document to DeCA</b>. You can replay this guide any time from Inventory &gt;"
" Configuration &gt; DeCA guided tour.</span>"
msgstr ""
"<span><b>Ese es todo el circuito del DeCA.</b> Y si prefiere llevar su "
"propio albarán, un DeCA en borrador lo convierte en el documento con "
"<b>Convertir documento a DeCA</b>. Puede repetir esta guía cuando quiera "
"desde Inventario &gt; Configuración &gt; Guía del DeCA.</span>"

