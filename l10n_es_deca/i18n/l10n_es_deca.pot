#. module: l10n_es_deca
#: model:mail.template,body_html:l10n_es_deca.mail_template_deca_issued
msgid ""
"<div style=\"margin:0px;padding:0px;font-size:13px;\">\n"
"                <p>Dear Sir or Madam,</p>\n"
"                <p>\n"
"                    The Electronic Administrative Control Document\n"
"                    <strong t-out=\"object.name\">DECA/2026/00001</strong>\n"
"                    has been issued for the transport scheduled on\n"
"                    <strong t-out=\"format_date(object.transport_date)\">09/21/2026</strong>.\n"
"                </p>\n"
"                <ul>\n"
"                    <li>Contractual shipper: <t t-out=\"object.shipper_id.name\"/> (<t t-out=\"object.shipper_vat\"/>)</li>\n"
"                    <li>Effective carrier: <t t-out=\"object.carrier_id.name\"/> (<t t-out=\"object.carrier_vat\"/>)</li>\n"
"                    <li>Tractor plate: <t t-out=\"object.tractor_plate_id.name or '-'\"/></li>\n"
"                    <li>Trailer plate: <t t-out=\"object.trailer_plate_id.name or '-'\"/></li>\n"
"                </ul>\n"
"                <p>\n"
"                    The document can be downloaded without identification from the\n"
"                    following link, the same one encoded in the QR printed on the PDF:\n"
"                    <br/>\n"
"                    <a t-att-href=\"object.public_url\" t-out=\"object.public_url\">link</a>\n"
"                </p>\n"
"                <p>\n"
"                    SHA-256 fingerprint of the PDF: <span t-out=\"object.pdf_sha256\"/>\n"
"                </p>\n"
"                <p>\n"
"                    Public access will be closed automatically on\n"
"                    <t t-out=\"format_date(object.access_close_date)\"/>,\n"
"                    seven calendar days after the end of the service.\n"
"                </p>\n"
"                <p><t t-out=\"object.company_id.name\"/></p>\n"
"            </div>\n"
"        "
msgstr ""

